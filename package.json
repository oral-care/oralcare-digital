{
  "name": "oralcare-digital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:em-dash": "node scripts/check-em-dash.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check": "pnpm run check:em-dash && pnpm run check:design && pnpm run check:migrations",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@date-fns/tz": "1.5.0",
    "@vercel/functions": "3.9.5",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "next": "16.4.2",
    "pg": "8.23.1",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vercel": "65.5.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,mjs,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "node scripts/check-em-dash.mjs"
    ]
  }
}
