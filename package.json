{
  "name": "oralcare-digital",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.5",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "next typegen && tsc --noEmit",
    "test": "vitest run --project unit",
    "test:integration": "vitest run --project integration",
    "test:e2e": "playwright test",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx scripts/migrate.ts",
    "check:em-dash": "node scripts/check-em-dash.mjs",
    "check:design": "node scripts/check-design.mjs",
    "check:migrations": "node scripts/check-migrations.mjs",
    "check:email-tokens": "node scripts/email-tokens.mjs --check",
    "email:preview": "tsx scripts/email-preview.ts",
    "tokens:email": "node scripts/email-tokens.mjs",
    "check": "pnpm run check:em-dash && pnpm run check:design && pnpm run check:migrations && pnpm run check:email-tokens",
    "pre-commit": "lint-staged",
    "pre-push": "pnpm run typecheck",
    "prepare": "husky"
  },
  "dependencies": {
    "@base-ui/react": "1.8.0",
    "@date-fns/tz": "1.5.0",
    "@vercel/functions": "3.10.5",
    "better-auth": "1.7.14",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "date-fns": "4.4.0",
    "drizzle-orm": "0.45.4",
    "intl-messageformat": "11.2.15",
    "lucide-react": "1.41.0",
    "next": "16.4.2",
    "next-intl": "4.14.2",
    "pg": "8.23.1",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-day-picker": "9.14.0",
    "react-dom": "19.2.8",
    "recharts": "3.8.0",
    "shadcn": "4.21.0",
    "tailwind-merge": "3.6.0",
    "tw-animate-css": "1.4.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "22.20.1",
    "@types/pg": "8.23.1",
    "@types/react": "19.2.18",
    "@types/react-dom": "19.2.7",
    "babel-plugin-react-compiler": "1.0.0",
    "drizzle-kit": "0.31.11",
    "embedded-postgres": "18.4.0-beta.17",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.4",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-boundaries": "7.4.0",
    "husky": "9.1.7",
    "lint-staged": "16.4.0",
    "prettier": "3.9.6",
    "tailwindcss": "4.3.3",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vercel": "65.5.0",
    "vitest": "5.0.5"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,css,md,mjs,yml,yaml}": [
      "prettier --write"
    ],
    "*": [
      "node scripts/check-em-dash.mjs"
    ]
  }
}
